# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Dart / Flutter source
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Platform-specific generated files — always LF
*.swift text eol=lf
*.cc    text eol=lf
*.h     text eol=lf
*.cmake text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.kt    text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.html  text eol=lf

# Shell scripts — always LF
*.sh    text eol=lf
gradlew text eol=lf

# Windows batch files — keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.zip   binary
*.keystore binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
